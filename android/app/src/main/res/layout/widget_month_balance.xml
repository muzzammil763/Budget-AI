<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/budget_widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/widget_logo_description"
            android:src="@drawable/ic_budget_mark" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <include layout="@layout/widget_month_switcher" />
    </LinearLayout>

    <TextView
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot_income" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:fontFamily="@font/google_sans"
            android:text="Income"
            android:textColor="@color/widget_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/balance_income"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autoSizeMaxTextSize="15sp"
        android:autoSizeMinTextSize="9sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="@font/boldonse"
        android:maxLines="1"
        android:text="$5,200"
        android:textColor="@color/widget_primary"
        android:textSize="15sp" />


    <ImageView

        android:id="@+id/balance_income_image"

        android:layout_width="match_parent"

        android:layout_height="16dp"

        android:adjustViewBounds="true"

        android:contentDescription="@null"

        android:scaleType="fitStart"

        android:tint="@color/widget_primary"

        android:visibility="gone"
        android:layout_marginTop="3dp" />

    <ProgressBar
        android:id="@+id/balance_income_bar"
        android:progress="1000"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="3dp"
        android:max="1000"
        android:progressDrawable="@drawable/widget_progress_income" />

    <TextView
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot_expense" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:fontFamily="@font/google_sans"
            android:text="Expenses"
            android:textColor="@color/widget_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/balance_expense"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autoSizeMaxTextSize="15sp"
        android:autoSizeMinTextSize="9sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="@font/boldonse"
        android:maxLines="1"
        android:text="$682.19"
        android:textColor="@color/widget_primary"
        android:textSize="15sp" />


    <ImageView

        android:id="@+id/balance_expense_image"

        android:layout_width="match_parent"

        android:layout_height="16dp"

        android:adjustViewBounds="true"

        android:contentDescription="@null"

        android:scaleType="fitStart"

        android:tint="@color/widget_primary"

        android:visibility="gone"
        android:layout_marginTop="3dp" />

    <ProgressBar
        android:id="@+id/balance_expense_bar"
        android:progress="131"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="3dp"
        android:max="1000"
        android:progressDrawable="@drawable/widget_progress_expense" />
</LinearLayout>
