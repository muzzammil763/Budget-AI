<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/budget_widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/widget_logo_description"
            android:src="@drawable/ic_budget_mark" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/google_sans"
            android:text="Today"
            android:textColor="@color/widget_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/today_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/google_sans"
            android:textColor="@color/widget_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/google_sans"
        android:text="Spent today"
        android:textColor="@color/widget_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/today_total"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autoSizeMaxTextSize="28sp"
        android:autoSizeMinTextSize="14sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="@font/boldonse"
        android:maxLines="1"
        android:text="$0"
        android:textColor="@color/widget_primary"
        android:textSize="28sp" />


    <ImageView

        android:id="@+id/today_total_image"

        android:layout_width="match_parent"

        android:layout_height="30dp"

        android:adjustViewBounds="true"

        android:contentDescription="@null"

        android:scaleType="fitStart"

        android:tint="@color/widget_primary"

        android:visibility="gone"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/today_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="@drawable/widget_pill_expense"
        android:fontFamily="@font/google_sans"
        android:paddingHorizontal="10dp"
        android:paddingVertical="3dp"
        android:text="0 entries"
        android:textColor="@color/widget_expense"
        android:textSize="11sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/widget_divider" />

    <LinearLayout
        android:id="@+id/list_rows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/list_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fontFamily="@font/google_sans"
        android:gravity="center"
        android:text="No expenses today"
        android:textColor="@color/widget_secondary"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
