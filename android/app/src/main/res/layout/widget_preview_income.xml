<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/budget_widget_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/flow_badge"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/widget_badge_income"
            android:contentDescription="@null"
            android:padding="6dp"
            android:src="@drawable/ic_widget_arrow_down_left" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <include layout="@layout/widget_month_switcher" />
    </LinearLayout>

    <TextView
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/total_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/google_sans"
        android:text="Income"
        android:textColor="@color/widget_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/total_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:autoSizeMaxTextSize="24sp"
        android:autoSizeMinTextSize="11sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="@font/boldonse"
        android:gravity="center"
        android:maxLines="1"
        android:text="$5,200"
        android:textColor="@color/widget_primary"
        android:textSize="22sp" />

    <TextView
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/total_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_pill_income"
        android:fontFamily="@font/google_sans"
        android:paddingHorizontal="10dp"
        android:paddingVertical="3dp"
        android:text="1 entry"
        android:textColor="@color/widget_income"
        android:textSize="11sp" />
</LinearLayout>
