---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

const subject = encodeURIComponent('Delete my Budget AI account');
const body = encodeURIComponent(
  'Please delete my Budget AI account and all of its data.\n\nAccount email: \n',
);
const mailto = `mailto:${site.email}?subject=${subject}&body=${body}`;

const removed = [
  'Your account and sign-in details',
  'Every expense and income entry',
  'Synced preferences: name, currency, bubble style',
  'AI usage records',
];
---

<Base
  title="Delete your account"
  description="How to permanently delete your Budget AI account and all of its data, in the app or by email."
>
  <section class="container page">
    <header class="reveal">
      <span class="eyebrow">Account deletion</span>
      <h1 class="display">Delete your<br />Budget AI account.</h1>
      <p class="lead">You can permanently delete your account and all of its data at any time, from the app or by email.</p>
    </header>

    <div class="grid">
      <section class="card step reveal">
        <span class="badge">Fastest</span>
        <h2>In the app</h2>
        <ol>
          <li>Open Budget AI and sign in.</li>
          <li>Tap <strong>Budget Hub</strong> (the settings icon, top right).</li>
          <li>Scroll to <strong>Danger Zone</strong> and tap <strong>Delete Account</strong>.</li>
          <li>Type <strong>DELETE MY ACCOUNT</strong> and confirm.</li>
        </ol>
        <p>Deletion is immediate and permanent.</p>
      </section>

      <section class="card step reveal" style="--delay: 0.06s">
        <span class="badge">Without the app</span>
        <h2>By email</h2>
        <p>Email us from the address you signed up with and ask us to delete your account. We confirm and complete deletion within 30 days, usually much sooner.</p>
        <a class="btn btn-primary" href={mailto}>Email a deletion request</a>
        <p class="small">{site.email}</p>
      </section>
    </div>

    <section class="card what reveal">
      <h2>What is deleted</h2>
      <ul>
        {removed.map((item) => <li>{item}</li>)}
      </ul>
      <p>Chat history, images, and AI summaries are stored only on your device. They are removed when you delete the account or sign out on that device, or when you uninstall the app.</p>
      <p>Deleted accounts cannot be restored. We keep nothing after deletion except where the law requires it.</p>
    </section>
  </section>
</Base>

<style>
  .page {
    padding: 56px 0 24px;
    display: grid;
    gap: 16px;
    max-width: 920px;
  }
  h1 {
    font-size: clamp(34px, 5vw, 56px);
    margin: 12px 0 14px;
  }
  .lead {
    max-width: 48ch;
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 16px;
  }
  .step,
  .what {
    padding: clamp(22px, 3vw, 32px);
  }
  .badge {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--soft);
    font-size: 13px;
    font-weight: 700;
  }
  h2 {
    margin: 12px 0 8px;
    font-size: 22px;
  }
  ol,
  ul {
    padding-left: 20px;
    display: grid;
    gap: 8px;
  }
  p,
  li {
    color: var(--muted);
  }
  li strong {
    color: var(--ink);
  }
  .btn {
    margin-top: 8px;
  }
  .small {
    font-size: 14px;
    margin-top: 10px;
  }
  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
