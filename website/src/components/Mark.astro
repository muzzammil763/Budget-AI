---
// The Budget AI mark: ring, rounded tile with rising bars, dot and sparkle.
// Colors flip with the theme like the app icon in light and dark.
interface Props {
  size?: number;
  class?: string;
}
const { size = 36, class: className } = Astro.props;
const id = `mark-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class:list={['mark', className]}
  width={size}
  height={size}
  viewBox="0 0 100 100"
  role="img"
  aria-label="Budget AI"
>
  <defs>
    <linearGradient id={`${id}-tile`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" class="mark-a"></stop>
      <stop offset="1" class="mark-b"></stop>
    </linearGradient>
    <linearGradient id={`${id}-ring`} x1="0" y1="1" x2="1" y2="0">
      <stop offset="0" stop-color="#448aff" stop-opacity="0"></stop>
      <stop offset="1" stop-color="#448aff" stop-opacity="0.75"></stop>
    </linearGradient>
  </defs>
  <path d="M50 4a46 46 0 1 1-46 46" fill="none" stroke={`url(#${id}-ring)`} stroke-width="3" stroke-linecap="round"></path>
  <rect x="11" y="11" width="78" height="78" rx="22" fill={`url(#${id}-tile)`}></rect>
  <rect class="mark-bar" x="30" y="56" width="10" height="19" rx="5"></rect>
  <rect class="mark-bar" x="45" y="45" width="10" height="30" rx="5"></rect>
  <rect class="mark-bar" x="60" y="34" width="10" height="41" rx="5"></rect>
  <circle cx="69" cy="22" r="4" fill="#448aff"></circle>
  <path d="M93 3l2.6 6.4L102 12l-6.4 2.6L93 21l-2.6-6.4L84 12l6.4-2.6z" fill="#448aff"></path>
</svg>

<style>
  .mark {
    overflow: visible;
    flex: none;
  }
  .mark-a {
    stop-color: #000;
  }
  .mark-b {
    stop-color: #132747;
  }
  .mark-bar {
    fill: #fff;
  }
  @media (prefers-color-scheme: dark) {
    .mark-a {
      stop-color: #fff;
    }
    .mark-b {
      stop-color: #cbdeff;
    }
    .mark-bar {
      fill: #050506;
    }
  }
</style>
