---
import type { CompanionScript } from '../data/companion';

// A small guide shaped like the Budget AI tile. It glides beside the section
// being read, picks a spot where its bubble covers no screenshot, types its
// line like a chat reply, and offers a step-by-step tour. Everything it says
// comes from the script prop.
interface Props {
  script: CompanionScript;
}
const { script } = Astro.props;
---

<div
  class="buddy"
  data-companion
  data-script={JSON.stringify(script)}
  data-mood="happy"
  data-side="right"
  data-v="up"
  hidden
  transition:persist
>
  <div class="bubble" role="status" aria-live="polite">
    <button class="bubble-close" type="button" aria-label="Close message">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>
    <span class="typing" aria-hidden="true"><i></i><i></i><i></i></span>
    <p class="bubble-text"></p>
    <div class="bubble-actions"></div>
    <div class="bubble-foot">
      <button class="bubble-hide" type="button">Hide helper</button>
      <span class="tour">
        <span class="count"></span>
        <button class="next" type="button">Next <span aria-hidden="true">›</span></button>
      </span>
    </div>
    <span class="dots" aria-hidden="true"><i></i><i></i></span>
  </div>
  <button class="pet" type="button" aria-label={`${script.name}: show message`}>
    <span class="tile" aria-hidden="true">
      <span class="gloss"></span>
      <span class="face">
        <span class="eye left"></span>
        <span class="eye right"></span>
        <span class="cheek left"></span>
        <span class="cheek right"></span>
        <span class="mouth"><i></i><i></i><i></i></span>
        <span class="oh"></span>
      </span>
    </span>
    <svg class="spark" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 0l3 9 9 3-9 3-3 9-3-9-9-3 9-3z"></path>
    </svg>
    <span class="blue-dot" aria-hidden="true"></span>
    <span class="zzz" aria-hidden="true">z</span>
  </button>
  <span class="shadow" aria-hidden="true"></span>
</div>

<script>
  import type { CompanionScript, CompanionStep, CompanionAction, Mood } from '../data/companion';

  type Step = CompanionStep & { el: Element };
  type TempMood = Mood | 'sleepy' | 'excited';
  type Side = 'left' | 'right';
  type Vertical = 'up' | 'down';
  type Box = { l: number; t: number; r: number; b: number };
  type Spot = { side: Side; v: Vertical; x: number; y: number };

  const safe = <T,>(fn: () => T, fallback: T): T => {
    try {
      return fn();
    } catch {
      return fallback;
    }
  };
  const clamp = (v: number, min: number, max: number) => Math.min(max, Math.max(min, v));
  const overlap = (a: Box, b: Box) =>
    Math.max(0, Math.min(a.r, b.r) - Math.max(a.l, b.l)) * Math.max(0, Math.min(a.b, b.b) - Math.max(a.t, b.t));

  let started = false;
  let refresh: () => void = () => {};

  function start() {
    const root = document.querySelector<HTMLElement>('[data-companion]');
    if (!root) return;
    if (started) {
      refresh();
      return;
    }
    started = true;

    const script: CompanionScript = JSON.parse(root.dataset.script || '{}');
    if (safe(() => localStorage.getItem(script.dismissKey), null) === '1') return;

    const pet = root.querySelector<HTMLButtonElement>('.pet')!;
    const face = root.querySelector<HTMLElement>('.face')!;
    const bubble = root.querySelector<HTMLElement>('.bubble')!;
    const text = root.querySelector<HTMLElement>('.bubble-text')!;
    const actions = root.querySelector<HTMLElement>('.bubble-actions')!;
    const count = root.querySelector<HTMLElement>('.count')!;
    const nextBtn = root.querySelector<HTMLButtonElement>('.next')!;
    const tour = root.querySelector<HTMLElement>('.tour')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const compact = matchMedia('(max-width: 760px)');
    const finePointer = matchMedia('(hover: hover) and (pointer: fine)').matches;

    let steps: Step[] = [];
    let active = -1;
    let mood: Mood = 'happy';
    let tempMood: TempMood | null = null;
    let asleep = false;
    let collapseTimer = 0;
    let idleTimer = 0;
    let typeTimer = 0;
    let shownAt = 0;
    let shownScroll = 0;
    let spot: Spot = { side: 'right', v: 'up', x: innerWidth - 120, y: innerHeight - 140 };
    let travel: { from: number; start: number; dur: number; arc: number } | null = null;
    let arcY = 0;

    const pos = { x: spot.x, y: innerHeight + 60 };
    const vel = { x: 0, y: 0 };
    const target = { x: pos.x, y: pos.y };
    const look = { x: 0, y: 0 };
    const pointer = { x: 0, y: 0, at: 0 };
    let lastScroll = scrollY;
    let scrollVel = 0;
    let running = false;
    let lastFrame = 0;

    const size = () => (compact.matches ? 56 : 68);
    const talking = () => root!.classList.contains('talking');

    // ---- Mood ----------------------------------------------------------
    function applyMood() {
      root!.dataset.mood = asleep ? 'sleepy' : (tempMood ?? mood);
    }
    function flash(m: TempMood, ms: number) {
      tempMood = m;
      applyMood();
      window.setTimeout(() => {
        if (tempMood === m) {
          tempMood = null;
          applyMood();
        }
      }, ms);
    }

    // ---- Placement -----------------------------------------------------
    // Scores every candidate spot beside the content and keeps the one whose
    // bubble covers no screenshot and the least text, near the section.
    function rects(selector: string) {
      const out: Box[] = [];
      if (!selector) return out;
      document.querySelectorAll(selector).forEach((el) => {
        if (root!.contains(el)) return;
        const r = el.getBoundingClientRect();
        if (r.bottom < 0 || r.top > innerHeight || r.width === 0) return;
        out.push({ l: r.left, t: r.top, r: r.right, b: r.bottom });
      });
      return out;
    }

    function bubbleBox(c: Spot, s: number, w: number, h: number): Box {
      const l = c.side === 'right' ? c.x - 16 - w : c.x + s + 16;
      if (compact.matches) {
        const bl = c.side === 'right' ? c.x + s - w : c.x;
        return c.v === 'up'
          ? { l: bl, r: bl + w, b: c.y - 24, t: c.y - 24 - h }
          : { l: bl, r: bl + w, t: c.y + s + 24, b: c.y + s + 24 + h };
      }
      const t = c.v === 'up' ? c.y + s * 0.55 - h : c.y + s * 0.4;
      return { l, r: l + w, t, b: t + h };
    }

    function score(c: Spot, shots: Box[], words: Box[], anchorY: number, preferred: Side) {
      const s = size();
      const w = bubble.offsetWidth;
      const h = bubble.offsetHeight;
      const bb = bubbleBox(c, s, w, h);
      if (bb.l < 8 || bb.r > innerWidth - 8 || bb.t < 80 || bb.b > innerHeight - 8) return Infinity;
      const me: Box = { l: c.x, t: c.y, r: c.x + s, b: c.y + s };
      let cost = 0;
      for (const r of shots) cost += overlap(bb, r) * 8 + overlap(me, r) * 3;
      for (const r of words) cost += overlap(bb, r) * 1.2 + overlap(me, r) * 0.6;
      cost += Math.abs(c.y - anchorY) * 24;
      if (c.side !== preferred) cost += 3500;
      if (compact.matches && c.v === 'down') cost += 2500;
      if (c.side !== spot.side) cost += 6000;
      return cost;
    }

    // Flips between the dark and light tile so it always contrasts with
    // the surface behind it, like the app icon in light and dark mode.
    function readSurface(x: number, y: number) {
      for (const el of document.elementsFromPoint(x, y)) {
        if (root!.contains(el)) continue;
        const m = getComputedStyle(el).backgroundColor.match(/[\d.]+/g);
        if (!m) continue;
        const [r, g, b, a = '1'] = m;
        if (+a < 0.5) continue;
        const lum = (0.2126 * +r + 0.7152 * +g + 0.0722 * +b) / 255;
        root!.classList.toggle('light-tile', lum < 0.45);
        return;
      }
      root!.classList.toggle('light-tile', matchMedia('(prefers-color-scheme: dark)').matches);
    }

    function place() {
      const s = size();
      const step = steps[active];
      const preferred: Side = step?.side ?? (active % 2 === 0 ? 'right' : 'left');
      const shots = rects(script.avoid);
      const words = rects(script.text);
      const candidates: Spot[] = [];

      if (compact.matches) {
        // Bottom corners talk upwards; top corners, under the header, talk
        // downwards. Whichever keeps the bubble off the screenshots wins.
        const bottom = innerHeight - s - 26;
        for (const side of ['right', 'left'] as Side[]) {
          const x = side === 'right' ? innerWidth - s - 16 : 16;
          candidates.push({ side, v: 'up', x, y: bottom });
          candidates.push({ side, v: 'down', x, y: 84 });
        }
      } else {
        const content = Math.min(innerWidth - 32, 1180);
        const xs: Record<Side, number> = {
          right: Math.min(innerWidth - s - 20, (innerWidth + content) / 2 + 22),
          left: Math.max(20, (innerWidth - content) / 2 - s - 22),
        };
        for (const side of ['right', 'left'] as Side[]) {
          for (const v of ['up', 'down'] as Vertical[]) {
            for (let y = 96; y <= innerHeight - s - 28; y += 22) {
              candidates.push({ side, v, x: xs[side], y });
            }
          }
        }
      }

      let anchorY = innerHeight * 0.45;
      if (step) {
        const r = step.el.getBoundingClientRect();
        anchorY = clamp(r.top + Math.min(r.height * 0.3, 200), 120, innerHeight - 160);
      }

      let best = spot;
      let bestCost = Infinity;
      for (const c of candidates) {
        const cost = score(c, shots, words, anchorY, preferred);
        if (cost < bestCost) {
          bestCost = cost;
          best = c;
        }
      }
      // Stay put unless the new spot is clearly better, so it never jitters.
      const current = candidates.find((c) => c.side === spot.side && c.v === spot.v && Math.abs(c.y - spot.y) < 11);
      const currentCost = current ? score(current, shots, words, anchorY, preferred) : Infinity;
      if (current && currentCost <= bestCost * 1.25 + 1500) best = current;
      if (!Number.isFinite(bestCost)) return;

      const switching = best.side !== spot.side;
      spot = best;
      root!.dataset.side = spot.side;
      root!.dataset.v = spot.v;
      target.x = spot.x;
      target.y = spot.y;
      readSurface(spot.x + s / 2, spot.y + s / 2);
      if (switching && root!.classList.contains('ready') && !reduce) {
        const dist = Math.abs(target.x - pos.x);
        travel = { from: pos.x, start: performance.now(), dur: clamp(dist * 0.8, 600, 1100), arc: clamp(dist * 0.13, 40, 120) };
      }
      wake();
    }

    // ---- Talking -------------------------------------------------------
    function renderActions(list: CompanionAction[] = []) {
      actions.replaceChildren(
        ...list.map((a) => {
          const link = document.createElement('a');
          link.href = a.href;
          link.textContent = a.label;
          link.className = a.primary ? 'mini primary' : 'mini';
          if (/^https?:/.test(a.href)) link.rel = 'noopener';
          link.addEventListener('click', () => collapse());
          return link;
        }),
      );
      actions.hidden = list.length === 0;
    }

    function say(message: string, list: CompanionAction[] = [], opts: { hold?: number; tourStep?: number } = {}) {
      const hold = opts.hold ?? (compact.matches ? 7000 : 9000);
      clearTimeout(typeTimer);
      clearTimeout(collapseTimer);

      // Lay out the whole reply first (words hidden) so the bubble keeps
      // its final size while it types and placement can measure it.
      const words = message.split(/(\s+)/).map((part) => {
        const span = document.createElement('span');
        span.textContent = part;
        if (part.trim()) span.className = 'w';
        return span;
      });
      text.replaceChildren(...words);
      renderActions(list);
      if (opts.tourStep !== undefined && steps.length > 1) {
        tour.hidden = false;
        count.textContent = `${opts.tourStep + 1} / ${steps.length}`;
        nextBtn.hidden = opts.tourStep >= steps.length - 1;
      } else {
        tour.hidden = true;
      }

      root!.classList.remove('talking', 'done');
      root!.classList.add('typing-on');
      void bubble.offsetWidth;
      root!.classList.add('talking');
      shownAt = performance.now();
      shownScroll = scrollY;
      place();

      const reveal = words.filter((w) => w.className === 'w');
      const finish = () => {
        root!.classList.remove('typing-on', 'speaking');
        root!.classList.add('done');
        if (hold > 0) collapseTimer = window.setTimeout(collapse, hold);
      };
      if (reduce) {
        reveal.forEach((w) => w.classList.add('on'));
        finish();
        return;
      }
      let i = 0;
      const tick = () => {
        if (i === 0) {
          root!.classList.remove('typing-on');
          root!.classList.add('speaking');
        }
        if (i < reveal.length) {
          reveal[i++].classList.add('on');
          typeTimer = window.setTimeout(tick, 55 + Math.random() * 45);
        } else {
          finish();
        }
      };
      typeTimer = window.setTimeout(tick, 520);
      wake();
    }

    function collapse() {
      clearTimeout(collapseTimer);
      clearTimeout(typeTimer);
      root!.classList.remove('talking', 'speaking', 'typing-on');
      place();
    }

    function hop() {
      if (reduce) return;
      pet.classList.remove('hop');
      void pet.offsetWidth;
      pet.classList.add('hop');
    }

    // ---- Steps ---------------------------------------------------------
    function resolve() {
      steps = script.steps
        .map((s) => ({ ...s, el: document.querySelector(s.anchor) }))
        .filter((s): s is Step => s.el !== null);
      root!.hidden = steps.length === 0;
      active = -1;
    }

    function pickActive() {
      const line = innerHeight * 0.42;
      let best = 0;
      for (let i = 0; i < steps.length; i++) {
        const r = steps[i].el.getBoundingClientRect();
        if (r.top <= line) best = i;
        if (r.top <= line && r.bottom >= line) {
          best = i;
          break;
        }
      }
      return best;
    }

    function update() {
      if (!steps.length) return;
      const next = pickActive();
      if (next !== active) {
        const first = active === -1;
        active = next;
        const step = steps[active];
        mood = step.mood ?? 'neutral';
        tempMood = null;
        applyMood();
        collapse();
        if (!first) hop();
        const index = active;
        window.setTimeout(
          () => {
            if (active === index) say(step.text, step.actions, { tourStep: index });
          },
          first ? 900 : travel ? travel.dur + 100 : 320,
        );
      } else {
        place();
      }
    }

    // ---- Motion --------------------------------------------------------
    function frame(now: number) {
      const dt = clamp((now - (lastFrame || now)) / 16.67, 0.5, 3);
      lastFrame = now;

      if (reduce) {
        pos.x = target.x;
        pos.y = target.y;
        vel.x = vel.y = 0;
        travel = null;
      } else {
        const k = 0.07;
        const damping = Math.pow(0.8, dt);
        if (travel) {
          const p = clamp((now - travel.start) / travel.dur, 0, 1);
          const e = p < 0.5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2;
          const prev = pos.x;
          pos.x = travel.from + (target.x - travel.from) * e;
          vel.x = (pos.x - prev) / dt;
          arcY = -Math.sin(p * Math.PI) * travel.arc;
          if (p >= 1) {
            travel = null;
            arcY = 0;
            vel.x = 0;
            pos.x = target.x;
            hop();
            // Catch up with any scrolling that happened mid-jump.
            requestAnimationFrame(() => update());
          }
        } else {
          vel.x = (vel.x + (target.x - pos.x) * k * dt) * damping;
          pos.x += vel.x * dt;
        }
        vel.y = (vel.y + (target.y - pos.y) * k * dt) * damping;
        pos.y += vel.y * dt;
      }

      scrollVel *= Math.pow(0.86, dt);
      const s = size();
      const cx = pos.x + s / 2;
      const cy = pos.y + s / 2;

      // Eyes: where it is jumping, else the pointer, else the scroll
      // direction, else the content beside it.
      let lx = spot.side === 'right' ? -0.6 : 0.6;
      let ly = clamp(scrollVel / 18, -1, 1);
      if (travel) {
        lx = Math.sign(target.x - travel.from);
        ly = -0.3;
      } else if (finePointer && now - pointer.at < 3500) {
        const dx = pointer.x - cx;
        const dy = pointer.y - cy;
        const d = Math.hypot(dx, dy) || 1;
        const reach = clamp(d / 220, 0, 1);
        lx = (dx / d) * reach;
        ly = (dy / d) * reach;
      }
      look.x += (lx - look.x) * 0.18 * dt;
      look.y += (ly - look.y) * 0.18 * dt;

      const tilt = reduce ? 0 : clamp(vel.x * 0.55 + vel.y * 0.45 + scrollVel * 0.22, -15, 15);
      const stretch = reduce
        ? 0
        : clamp(Math.abs(vel.y) * 0.011 + Math.abs(scrollVel) * 0.004 + (travel ? 0.08 : 0), 0, 0.13);

      root!.style.transform = `translate3d(${pos.x.toFixed(1)}px, ${(pos.y + arcY).toFixed(1)}px, 0)`;
      root!.style.setProperty('--tilt', `${tilt.toFixed(2)}deg`);
      root!.style.setProperty('--sy', (1 + stretch).toFixed(3));
      root!.style.setProperty('--sx', (1 - stretch * 0.7).toFixed(3));
      face.style.transform = `translate(${(look.x * 6).toFixed(2)}px, ${(look.y * 5).toFixed(2)}px)`;

      const settled =
        !travel &&
        Math.abs(target.x - pos.x) < 0.3 &&
        Math.abs(target.y - pos.y) < 0.3 &&
        Math.abs(vel.x) + Math.abs(vel.y) < 0.05 &&
        Math.abs(scrollVel) < 0.05 &&
        now - pointer.at > 3600;
      if (settled) {
        running = false;
        lastFrame = 0;
        return;
      }
      requestAnimationFrame(frame);
    }

    function wake() {
      if (running || document.hidden) return;
      running = true;
      requestAnimationFrame(frame);
    }

    function blinkLoop() {
      window.setTimeout(() => {
        if (!asleep && !document.hidden) {
          root!.classList.add('blink');
          window.setTimeout(() => root!.classList.remove('blink'), 150);
        }
        blinkLoop();
      }, 2400 + Math.random() * 3800);
    }

    function activity() {
      if (asleep) {
        asleep = false;
        applyMood();
        collapse();
      }
      clearTimeout(idleTimer);
      idleTimer = window.setTimeout(() => {
        asleep = true;
        applyMood();
        say(script.idle, [], { hold: 0 });
      }, 30000);
    }

    // ---- Events --------------------------------------------------------
    let lastPlace = 0;
    let ticking = false;
    let settleTimer = 0;
    addEventListener(
      'scroll',
      () => {
        scrollVel = clamp(scrollVel + (scrollY - lastScroll) * 0.35, -60, 60);
        lastScroll = scrollY;
        activity();
        // Step aside once the reader keeps scrolling through the section.
        if (talking() && performance.now() - shownAt > 2600 && Math.abs(scrollY - shownScroll) > 220) {
          collapse();
        }
        clearTimeout(settleTimer);
        settleTimer = window.setTimeout(() => {
          if (!travel) update();
        }, 140);
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          const now = performance.now();
          const next = pickActive();
          if (next !== active || now - lastPlace > 110) {
            lastPlace = now;
            if (!travel) update();
          }
          wake();
        });
      },
      { passive: true },
    );
    addEventListener('resize', () => update(), { passive: true });
    compact.addEventListener('change', () => update());

    addEventListener(
      'pointermove',
      (e) => {
        pointer.x = e.clientX;
        pointer.y = e.clientY;
        pointer.at = performance.now();
        activity();
        wake();
      },
      { passive: true },
    );

    document.addEventListener('pointerover', (e) => {
      const over = (e.target as Element | null)?.closest?.('.btn-primary, .mini.primary');
      const next: TempMood | null = over ? 'excited' : null;
      if (next !== tempMood) {
        tempMood = next;
        applyMood();
      }
    });

    document.addEventListener('mouseout', (e) => {
      if (!finePointer || e.relatedTarget || e.clientY > 0) return;
      if (safe(() => sessionStorage.getItem('companion-exit'), null)) return;
      safe(() => sessionStorage.setItem('companion-exit', '1'), undefined);
      flash('surprised', 2500);
      hop();
      say(script.exit.text, script.exit.actions, { hold: 12000 });
    });

    pet.addEventListener('click', () => {
      hop();
      if (talking()) {
        flash('excited', 900);
        return;
      }
      const index = Math.max(active, 0);
      const step = steps[index];
      if (step) say(step.text, step.actions, { tourStep: index });
    });
    nextBtn.addEventListener('click', () => {
      const next = steps[Math.max(active, 0) + 1];
      if (!next) return;
      collapse();
      next.el.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
    });
    root.querySelector('.bubble-close')!.addEventListener('click', collapse);
    root.querySelector('.bubble-hide')!.addEventListener('click', () => {
      safe(() => localStorage.setItem(script.dismissKey, '1'), undefined);
      root.hidden = true;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') collapse();
    });
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) wake();
    });

    refresh = () => {
      resolve();
      update();
    };

    resolve();
    if (!steps.length) return;
    spot = { ...spot, side: steps[0].side ?? 'right' };
    place();
    pos.x = target.x;
    pos.y = innerHeight + 40;
    window.setTimeout(() => {
      root.classList.add('ready');
      update();
    }, 600);
    blinkLoop();
    activity();
  }

  document.addEventListener('astro:page-load', start);
</script>

<style>
  .buddy {
    --s: 68px;
    --tile-a: #000;
    --tile-b: #132747;
    --feature: #fff;
    --spark: #448aff;
    --bubble-accent: #ff7a45;
    position: fixed;
    left: 0;
    top: 0;
    z-index: 60;
    width: var(--s);
    height: var(--s);
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
    will-change: transform;
  }
  .buddy[hidden] {
    display: none;
  }
  .buddy.ready {
    opacity: 1;
  }
  .buddy.ready .pet,
  .buddy.ready.talking .bubble {
    pointer-events: auto;
  }

  /* Character: the app tile with a face and the rising bars as a mouth. */
  .pet {
    all: unset;
    position: relative;
    display: block;
    width: var(--s);
    height: var(--s);
    font-size: calc(var(--s) / 6.8);
    cursor: pointer;
    transform-origin: 50% 100%;
    transform: rotate(var(--tilt, 0deg)) scale(var(--sx, 1), var(--sy, 1));
  }
  .pet:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
    border-radius: 30%;
  }
  .tile {
    position: absolute;
    inset: 0;
    border-radius: 30%;
    background: linear-gradient(135deg, var(--tile-a), var(--tile-b));
    box-shadow:
      inset 0 0.15em 0.4em rgba(255, 255, 255, 0.14),
