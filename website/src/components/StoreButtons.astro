---
import { site } from '../data/site';
interface Props {
  invert?: boolean;
}
const { invert = false } = Astro.props;
---

<div class:list={['stores', { invert }]}>
  <a class="btn btn-primary" href={site.playStoreUrl} rel="noopener">
    <svg class="play-logo" viewBox="0 0 24 24" aria-hidden="true">
      <!-- Google Play's four-colour mark -->
      <path fill="#4285F4" d="M3.7 2.1 13.6 12l-9.9 9.9c-.4-.3-.7-.8-.7-1.4V3.5c0-.6.3-1.1.7-1.4z"></path>
      <path fill="#34A853" d="M3.7 2.1c.5-.3 1.1-.3 1.7 0l11.5 6.6L13.6 12z"></path>
      <path fill="#FBBC04" d="M16.9 8.7l3.4 2c1 .6 1 2 0 2.6l-3.4 2L13.6 12z"></path>
      <path fill="#EA4335" d="M13.6 12l3.3 3.3-11.5 6.6c-.6.3-1.2.3-1.7 0z"></path>
    </svg>
    <span><small>Get it on</small>Google Play</span>
  </a>
  <span class="btn btn-ghost soon" aria-disabled="true">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path fill="currentColor" d="M16.4 12.6c0-2.5 2-3.6 2.1-3.7-1.2-1.7-3-1.9-3.6-2-1.5-.2-3 .9-3.8.9-.8 0-2-.9-3.3-.9-1.7 0-3.3 1-4.2 2.5-1.8 3.1-.5 7.7 1.3 10.2.9 1.2 1.9 2.6 3.2 2.6 1.3-.1 1.8-.8 3.3-.8 1.6 0 2 .8 3.3.8 1.4 0 2.3-1.3 3.1-2.5 1-1.4 1.4-2.8 1.4-2.9-.1 0-2.8-1.1-2.8-4.2zM14 5.1c.7-.9 1.2-2 1-3.2-1 0-2.3.7-3 1.6-.7.8-1.2 2-1.1 3.1 1.2.1 2.3-.6 3.1-1.5z"></path>
    </svg>
    <span><small>Coming soon to</small>iPhone</span>
  </span>
</div>

<style>
  .stores {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .soon {
    cursor: default;
  }
  .soon:hover {
    transform: none;
  }
  .invert .btn-primary {
    background: var(--on-ink);
    color: var(--ink);
  }
  .invert .btn-ghost {
    background: transparent;
    color: var(--on-ink);
    border-color: color-mix(in srgb, var(--on-ink) 25%, transparent);
  }
</style>
