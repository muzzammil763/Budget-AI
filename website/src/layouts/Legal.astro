---
import Base from './Base.astro';
import type { LegalSection } from '../data/legal';
import { site } from '../data/site';

interface Props {
  title: string;
  eyebrow: string;
  headline: string;
  intro: string;
  sections: LegalSection[];
  highlights?: string[];
}
const { title, eyebrow, headline, intro, sections, highlights = [] } = Astro.props;
const slug = (text: string) => text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
---

<Base title={title} description={intro}>
  <section class="container doc">
    <aside class="toc" aria-label="On this page">
      <span class="eyebrow">On this page</span>
      <ol>
        {sections.map((s) => <li><a href={`#${slug(s.title)}`}>{s.title}</a></li>)}
      </ol>
    </aside>
    <article>
      <header class="card hero reveal">
        <span class="eyebrow">{eyebrow}</span>
        <h1 class="display" set:html={headline} />
        <p class="lead">{intro}</p>
        <p class="date">Effective {site.effectiveDate}</p>
      </header>
      {
        highlights.length > 0 && (
          <ul class="highlights reveal">
            {highlights.map((h) => <li class="card">{h}</li>)}
          </ul>
        )
      }
      {
        sections.map((section, i) => (
          <section class="card block reveal" id={slug(section.title)}>
            <h2>
              <span>{String(i + 1).padStart(2, '0')}</span>
              {section.title}
            </h2>
            {section.paragraphs.map((p) => <p>{p}</p>)}
            {section.bullets && (
              <ul>
                {section.bullets.map((b) => <li>{b}</li>)}
              </ul>
            )}
          </section>
        ))
      }
      <a class="contact reveal" href={`mailto:${site.email}`}>
        <span>
          <strong>Questions?</strong>
          <em>{site.email}</em>
        </span>
        <b aria-hidden="true">→</b>
      </a>
    </article>
  </section>
</Base>

<style>
  .doc {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 48px;
    padding: 48px 0 24px;
    align-items: start;
  }
  .toc {
    position: sticky;
    top: 104px;
  }
  .toc ol {
    list-style: none;
    padding: 0;
    margin: 14px 0 0;
    display: grid;
    gap: 4px;
    counter-reset: toc;
  }
  .toc a {
    display: block;
    padding: 6px 10px;
    border-radius: 10px;
    text-decoration: none;
    color: var(--muted);
    font-size: 15px;
  }
  .toc a:hover {
    background: var(--soft);
    color: var(--ink);
  }
  article {
    display: grid;
    gap: 12px;
    max-width: 760px;
  }
  .hero {
    padding: clamp(24px, 4vw, 40px);
  }
  .hero h1 {
    font-size: clamp(32px, 5vw, 52px);
    margin: 12px 0 14px;
  }
  .hero .lead {
    max-width: 52ch;
    margin: 0;
  }
  .date {
    margin: 18px 0 0;
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
  }
  .highlights {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  .highlights li {
    padding: 16px 18px;
    font-weight: 600;
  }
  .block {
    padding: clamp(20px, 3vw, 28px);
  }
  .block h2 {
    display: flex;
    gap: 14px;
    align-items: baseline;
    margin: 0 0 6px;
    font-size: 20px;
  }
  .block h2 span {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--muted);
  }
  .block p,
  .block li {
    color: var(--muted);
  }
  .block p {
    margin: 10px 0 0;
  }
  .block ul {
    margin: 10px 0 0;
    padding-left: 20px;
    display: grid;
    gap: 6px;
  }
  .contact {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 22px 26px;
    border-radius: var(--radius);
    background: var(--ink);
    color: var(--on-ink);
    text-decoration: none;
    margin-top: 8px;
  }
  .contact span {
    display: grid;
  }
  .contact em {
    font-style: normal;
    opacity: 0.75;
  }
  .contact b {
    font-size: 22px;
  }
  @media (max-width: 900px) {
    .doc {
      grid-template-columns: 1fr;
      padding-top: 24px;
    }
    .toc {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .highlights {
      grid-template-columns: 1fr;
    }
  }
</style>
